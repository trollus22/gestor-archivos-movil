# ==============================================================================
# Configuración del Gestor de Archivos Web
# ==============================================================================

# Entorno de ejecución (development | production)
NODE_ENV=production

# Host y Puerto (IMPORTANTE: Debe escuchar SOLO en 127.0.0.1 por seguridad)
HOST=127.0.0.1
PORT=3888

# Raíz permitida del sistema de ficheros (por defecto '/')
ROOT_DIR=/

# Carpeta de Papelera (por defecto ~/.gestion-trash)
TRASH_DIR=

# Credenciales de Administrador
# ADMIN_PASSWORD_HASH: Hash bcrypt de la contraseña.
# Si solo defines ADMIN_PASSWORD (en texto plano), el servidor generará el hash en memoria al iniciar.
ADMIN_USER=admin
ADMIN_PASSWORD=CambiarEstaClaveSegura123!
# ADMIN_PASSWORD_HASH=$2a$10$XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Clave secreta para firmar sesiones y cookies
SESSION_SECRET=cambiar_este_secreto_super_seguro_y_aleatorio_para_produccion_2026

# Seguridad de Cookies (true si se accede por HTTPS detrás de nginx proxy)
COOKIE_SECURE=false

# Límite de subida de archivos por trozo (en bytes o MB) - La subida chunked admite archivos de varios GB
MAX_CHUNK_SIZE_MB=25
MAX_FILE_SIZE_GB=10

# Límite de intentos de login antes del bloqueo temporal (intentos / ventana en minutos / minutos de bloqueo)
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_LOCKOUT_MINUTES=15

# Consola web de terminal (opcional y DESACTIVADA por defecto: false)
ENABLE_TERMINAL=false

# Ruta de almacenamiento del registro de actividad
ACTIVITY_LOG_FILE=
